* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Helvetica, Arial, sans-serif;
  font-size: 16px;
  color: #222;
}

.ancho {
  max-width: 1170px;
  margin: auto;
}

.linea_naranja {
  height: 20px;
  background-color: #ee9900;
}

.cabecera {
  height: 224px;
  background-color: #061438;
  text-align: center;
  padding-top: 25px;
}

.cabecera img {
  width: 165px;
  height: 165px;
}

.titulo_principal {
  text-align: center;
  padding: 10px 0 5px;
  background-color: #f1f3f5;
}

.titulo_principal h1 {
  color: #00759e;
  font-size: 31px;
}

.titulo_principal hr {
  width: 62px;
  height: 5px;
  margin: 13px auto 0;
  border: 0;
  background-color: #d60000;
}

.formulario_contenedor {
  margin-top: 26px;
  margin-bottom: 26px;
  padding: 10px 16px 60px;
  border: 2px solid #0081ae;
  border-radius: 10px;
}

.formulario_contenedor h2 {
  color: #ee9900;
  text-align: center;
  font-size: 25px;
  margin-bottom: 32px;
}

.formulario_contenedor p {
  font-size: 21px;
  font-weight: bold;
  margin: 0 8% 45px;
}

.columna {
  width: 50%;
  float: left;
  padding: 0 8px;
}

.form,
.elementoformulario {
  width: 100%;
  height: 40px;
  margin-bottom: 10px;
  padding: 8px 10px;
  border: 1px solid #cccccc;
  border-radius: 5px;
  font-size: 16px;
}

.form:focus,
.elementoformulario:focus {
  outline: 2px solid #007cff;
}

.personas {
  margin: 10px 0;
  color: #777;
}

.personas input {
  margin-left: 8px;
}

.limpiar {
  clear: both;
}

.btn_rojo {
  width: 49%;
  margin: 48px 0 0 8px;
  padding: 10px;
  border: 0;
  border-radius: 22px;
  background-color: #d60000;
  color: white;
  font-size: 16px;
}

.btn_rojo:hover {
  background-color: #ad0000;
}

footer {
  padding: 30px;
  background-color: #061438;
  color: white;
  text-align: center;
  font-size: 20px;
  font-weight: bold;
  line-height: 1.25;
}
